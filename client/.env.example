# URL of the Node API. Set to your deployed API origin for production builds.
VITE_API_URL=http://localhost:4000

# Used only by the /admin/ dashboard. From Supabase: Project Settings > API.
# The anon (public) key is safe to expose; RLS restricts reads to emails in public.admins.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
